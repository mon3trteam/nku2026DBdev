ass=\"title\"><a href=\"/2026/0429/c17471a593993/page.htm\" target=\"_blank\">南开大学附属小学2026年招生登记工作通知</a></div>\r\n\t\t\t\t\t\t\t\t<div class=\"clear\"></div>\r\n\t\t\t\t\t\t\t</li>\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t</ul></div> \r\n\r\n\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t\t<div class=\"xshd infos_con\" frag=\"面板13\" style=\"display:none\">\t\t\t\t\t\r\n\t\t\t\t\t<div class=\"xsrl\" frag=\"窗口13\" portletmode=\"simpleNews\" configs=\"{'c8':'0','c42':'320','c25':'320','c30':'0','c29':'1','c22':'0','c23':'1','c34':'300','c20':'0','c31':'0','c16':'1','c3':'100','c2':'序号,标题,发布时间','c27':'480','c43':'0','c17':'0','c5':'_blank','c24':'240','c32':'','c26':'1','c37':'1','c28':'640','c40':'1','c15':'0','c14':'1','c44':'0','c33':'500','c10':'50','c18':'yyyy-MM-dd','c36':'0','c1':'1','c6':'-1','c19':'yyyy-MM-dd','c21':'0','c4':'1','c35':'-1:-1','c39':'300','c38':'100','c7':'1','c12':'0','c9':'0','c11':'1','c13':'200','c41':'240'}\" contents=\"{'c2':'0', 'c1':'/今日南开/学术活动'}\">\t\t\t\t\t                                              \r\n\t\t\t\t\t\t<div id=\"wp_news_w13\"> \r\n\r\n                        <script type=\"text/javascript\">\r\n\t\t\t\t\t\t var calendarData = [\t\t\t\t\t\t              \r\n\t\t\t\t\t\t   \r\n\t\t\t\t\t\t  {\r\n\t\t\t\t\t\t \"user\":\"历史学院   柏悦 \",\r\n\t\t\t\t\t\t \"date\":\"2026-11-26 10:00\",\r\n\t\t\t\t\t\t \"date1\":\"2026-11-26 10:00\",\r\n\t\t\t\t\t\t \"addr\":\"津南校区 历史学院127\",\r\n\t\t\t\t\t\t \"title\":\"兰普莱希特与19-20世纪之交德国史学转向\",\r\n\t\t\t\t\t\t \"url\":\"http://xcsx.nankai.edu.cn/infoplus/launch/xml\",\r\n\t\t\t\t\t\t \"img\":\"\"\r\n\t\t\t\t\t\t  },\r\n\t\t\t\t\t\t  \r\n\t\t\t\t\t\t  {\r\n\t\t\t\t\t\t \"user\":\"泰达应用物理研究院   段嘉华 \",\r\n\t\t\t\t\t\t \"date\":\"2026-11-20 14:30\",\r\n\t\t\t\t\t\t \"date1\":\"2026-11-20 14:30\",\r\n\t\t\t\t\t\t \"addr\":\"八里台校区 伯苓楼A205\",\r\n\t\t\t\t\t\t \"title\":\"跨尺度各向异性光子学研究\",\r\n\t\t\t\t\t\t \"url\":\"http://xcsx.nankai.edu.cn/infoplus/launch/xml\",\r\n\t\t\t\t\t\t \"img\":\"\"\r\n\t\t\t\t\t\t  },\r\n\t\t\t\t\t\t  \r\n\t\t\t\t\t\t  {\r\n\t\t\t\t\t\t \"user\":\"化学学院   蔡佳蓉 \",\r\n\t\t\t\t\t\t \"date\":\"2026-11-08 15:00\",\r\n\t\t\t\t\t\t \"date1\":\"2026-11-08 15:00\",\r\n\t\t\t\t\t\t \"addr\":\"八里台校区 天南楼4楼报告厅\",\r\n\t\t\t\t\t\t \"title\":\"科研之路，始于起步。然而许多研究生在进入实验室之初，往往面临课题方向依赖导师安排、文献阅读缺乏系统规划、实验进展受阻时无从着手等困境，长期处于被动等待的状态，难以真正进入科研角色。如何从 &quot;被动跟随&quot; 转向 &quot;主动引领&quot;，是每一位科研新手必须跨越的第一道门槛。本次讲座聚焦科研起步阶段的核心能力建设，围绕四方面内容展开：一、课题定位与选题方法：在导师研究框架内自主识别有价值的研究问题，实现从 &quot;接收课题&quot; 到 &quot;提出课题&quot; 的转变；二、文献阅读与信息管理：构建系统化的文献阅读体系与个人知识地图，使文献调研切实服务于课题决策；三、实验规划与过程管理*：以 &quot;假设 — 验证&quot; 的科学思维规范实验设计与记录，将阶段性结果转化为可持续的研究经验；四、自我驱动与时间管理：建立个人化的科研节奏与执行计划，变 &quot;等待安排&quot; 为 &quot;自主推进&quot;，为研究生阶段的学习与成长奠定坚实基础。\",\r\n\t\t\t\t\t\t \"url\":\"http://xcsx.nankai.edu.cn/infoplus/launch/xml\",\r\n\t\t\t\t\t\t \"img\":\"\"\r\n\t\t\t\t\t\t  },\r\n\t\t\t\t\t\t  \r\n\t\t\t\t\t\t  {\r\n\t\t\t\t\t\t \"user\":\"化学学院   关庆鑫 \",\r\n\t\t\t\t\t\t \"date\":\"2026-11-07 16:44\",\r\n\t\t\t\t\t\t \"date1\":\"2026-11-07 16:44\",\r\n\t\t\t\t\t\t \"addr\":\"八里台校区 天南楼4楼报告厅\",\r\n\t\t\t\t\t\t \"title\":\"催化剂从基础研究走向工业应用之路\",\r\n\t\t\t\t\t\t \"url\":\"http://xcsx.nankai.edu.cn/infoplus/launch/xml\",\r\n\t\t\t\t\t\t \"img\":\"\"\r\n\t\t\t\t\t\t  },\r\n\t\t\t\t\t\t  \r\n\t\t\t\t\t\t  {\r\n\t\t\t\t\t\t \"user\":\"电子信息与光学工程学院   James Durrant，Ji-Seon Kim \",\r\n\t\t\t\t\t\t \"date\":\"2026-11-11 14:30\",\r\n\t\t\t\t\t\t \"date1\":\"2026-11-11 14:30\",\r\n\t\t\t\t\t\t \"addr\":\"津南校区 津南校区交叉大楼\",\r\n\t\t\t\t\t\t \"title\":\"1.Operando optical analyses of water oxidation photo- and electro-catalysis.2.Manipulating Polarons in Organic Semiconductors: From Molecular Structure to Device Function\",\r\n\t\t\t\t\t\t \"url\":\"http://xcsx.nankai.edu.cn/infoplus/launch/xml\",\r\n\t\t\t\t\t\t \"img\":\"https://ehall.nankai.edu.cn/workflow/api/v1.file/detail/906188583579156480/\"\r\n\t\t\t\t\t\t  },\r\n\t\t\t\t\t\t  \r\n\t\t\t\t\t\t  {\r\n\t\t\t\t\t\t \"user\":\"社会学院   芮东根 \",\r\n\t\t\t\t\t\t \"date\":\"2026-11-10 15:30\",\r\n\t\t\t\t\