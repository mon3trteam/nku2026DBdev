{
  "manifest_version": 3,
  "name": "网页表格 → SQL 生成器",
  "version": "1.0.0",
  "description": "抓取当前网页中的表格，一键生成 CREATE TABLE 与 INSERT 语句，可复制或下载为 .sql 文件。",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "网页表格 → SQL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
