# =====================================================================
# 文件名：.env.example
# 功能：docker compose 环境变量样例；复制为 code/.env 后按需修改
# 作者：金暄琛（2411672）
# 创建日期：2026-11-08
# 所属模块：部署 / 配置
#
# 说明：
#   1) bash:   cp .env.example .env
#      PowerShell: Copy-Item .env.example .env
#   2) .env 不入 Git；下列值只是占位符，生产环境必须换成随机强口令。
#   3) MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD 只在数据卷首次初始化时生效；
#      已有数据卷需进入 db 容器执行 ALTER USER 才能改口令。
# =====================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# ---- 应用 ----
# 至少 32 字节随机串；可用 `php -r "echo bin2hex(random_bytes(32));"` 生成
APP_KEY=change-me-to-a-random-32-byte-secret
# 生产环境必须为 false
APP_DEBUG=false
# 会话空闲过期秒数
SESSION_LIFETIME=1800
# 与 uploads.ini 的 upload_max_filesize 保持一致的业务侧上限（MB）
UPLOAD_MAX_MB=10
