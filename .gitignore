# ===== 系统与编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# ===== 运行时与日志 =====
*.log
code/runtime/
code/backups/
code/storage/uploads/
code/storage/exports/
code/public/static/uploads/*
!code/public/static/uploads/.htaccess

# ===== 依赖与临时 =====
vendor/
node_modules/
tmp/
*.tmp

# 前端本地化静态依赖需要入库（上面的 vendor/ 只针对 PHP Composer）
!code/public/static/vendor/
!code/public/static/vendor/**

# ===== 敏感配置（本地环境差异）=====
code/app/config.local.php
code/.env

# ===== 大文件（不入库，交付时放入 data/）=====
# 团队文档 PDF 与个人作业 zip 最终需要放 code/data/ 交付，此处不忽略
